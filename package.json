{
  "name": "scrcpy-harmony",
  "productName": "Scrcpy Harmony",
  "appId": "io.github.monsterxia.scrcpyharmony",
  "version": "1.0.4",
  "description": "Harmony hdc desktop app",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs && node script/test-licia.mjs && node script/test-licia.mjs --fallback",
    "dev": "concurrently \"node script/build-vendor.mjs --watch --skip-initial\" \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --watch --config vite.main.ts --mode=development",
    "dev:preload": "vite build --watch --config vite.preload.ts --mode=development",
    "dev:renderer": "vite",
    "build:main": "vite build --config vite.main.ts",
    "build:preload": "vite build --config vite.preload.ts",
    "build:renderer": "vite build",
    "build": "node script/build.mjs",
    "pack": "zx script/pack.mjs",
    "start": "electron ./dist/main/index.js --inspect=9229",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && npm run check:i18n",
    "check:i18n": "node script/check-i18n.mjs",
    "init": "npm run resources",
    "resources": "zx script/resources.mjs",
    "format": "lsla prettier \"src/**/*.{ts,tsx,scss,css,json}\" \"*.{js,ts,json}\" \"script/*.mjs\" --write",
    "gen:icon": "lsla genIcon --input src/renderer/ --output src/renderer/icon.css --name scrcpy-harmony-icon --source src/renderer/icon/",
    "gen:theme": "lsla genTheme --input src/common/theme.json --output src/renderer/theme.scss && lsla genTheme --input src/common/theme.json --output src/common/theme.ts",
    "build:vendor": "node script/build-vendor.mjs",
    "postinstall": "npm run build:vendor",
    "pretest": "npm run build:vendor",
    "predev": "npm run build:vendor",
    "prebuild:main": "npm run build:vendor",
    "prebuild:preload": "npm run build:vendor",
    "prebuild:renderer": "npm run build:vendor",
    "test:licia": "node script/test-licia.mjs",
    "pretest:licia": "npm run build:vendor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MonsterXia/scrcpy-harmony.git"
  },
  "keywords": [
    "hdc",
    "harmony"
  ],
  "author": "MonsterXia",
  "contributors": [
    "MonsterXia"
  ],
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/MonsterXia/scrcpy-harmony/issues"
  },
  "homepage": "https://github.com/MonsterXia/scrcpy-harmony#readme",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.779.0",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-arrow-functions": "7.29.7",
    "@babel/plugin-transform-block-scoping": "7.29.7",
    "@babel/plugin-transform-destructuring": "7.29.7",
    "@babel/plugin-transform-parameters": "7.29.7",
    "@babel/plugin-transform-shorthand-properties": "7.29.7",
    "@babel/plugin-transform-template-literals": "7.29.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.8",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "10.6.1",
    "axios": "^1.8.4",
    "builder-util-runtime": "9.7.0",
    "chai": "4.5.0",
    "concurrently": "^9.1.2",
    "custom-electron-titlebar": "^4.4.1",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "fs-extra": "^11.3.0",
    "globals": "^16.0.0",
    "hdckit": "file:vendor/packages/hdckit",
    "jsdom": "^26.1.0",
    "licia": "file:vendor/packages/licia",
    "luna-command-palette": "file:vendor/packages/luna-command-palette",
    "luna-data-grid": "file:vendor/packages/luna-data-grid",
    "luna-dom-viewer": "file:vendor/packages/luna-dom-viewer",
    "luna-drag-selector": "file:vendor/packages/luna-drag-selector",
    "luna-icon-list": "file:vendor/packages/luna-icon-list",
    "luna-image-viewer": "file:vendor/packages/luna-image-viewer",
    "luna-logcat": "file:vendor/packages/luna-logcat",
    "luna-menu": "file:vendor/packages/luna-menu",
    "luna-modal": "file:vendor/packages/luna-modal",
    "luna-notification": "file:vendor/packages/luna-notification",
    "luna-performance-monitor": "file:vendor/packages/luna-performance-monitor",
    "luna-setting": "file:vendor/packages/luna-setting",
    "luna-split-pane": "file:vendor/packages/luna-split-pane",
    "luna-tab": "file:vendor/packages/luna-tab",
    "luna-toolbar": "file:vendor/packages/luna-toolbar",
    "luna-virtual-list": "file:vendor/packages/luna-virtual-list",
    "mobx": "^6.13.6",
    "mobx-react-lite": "^4.1.0",
    "mocha": "11.8.0",
    "parse5": "7.3.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.85.1",
    "semver": "7.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^5.4.14",
    "zx": "^8.4.1"
  }
}
